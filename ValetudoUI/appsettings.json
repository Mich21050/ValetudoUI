{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Valetudo": {
    "BaseUrl": "http://ROBOT_IP",
    "Username": null,
    "Password": null,
    "UseFakeRobot": false
  },
  "History": {
    "MinRunSeconds": 30,
    "CheckpointSeconds": 60,
    "ResumableGraceMinutes": 20,
    "DbFileName": "valetudo-ui.db",
    "MergeWindowSeconds": 120
  },
  "Telegram": {
    "BotToken": null,
    "ChatId": null,
    "NotifyRunCompleted": true,
    "NotifyErrors": true,
    "Silent": false
  }
}
